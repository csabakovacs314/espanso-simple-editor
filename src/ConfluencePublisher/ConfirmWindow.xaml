<Window x:Class="ConfluencePublisher.ConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirm publishing" Width="680" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" FontFamily="{StaticResource UiFont}" FontSize="13.5" Background="{StaticResource PanelBrush}" Foreground="{StaticResource InkBrush}">
    <StackPanel Margin="22,18,22,18">
        <TextBlock x:Name="HeadingText" FontSize="18" FontWeight="SemiBold"/>
        <TextBlock Text="The guide will go under this parent page:" Margin="0,12,0,4" Foreground="{StaticResource LabelBrush}"/>
        <Border Padding="12,8" CornerRadius="7" Background="{StaticResource AccentSoftBrush}" BorderBrush="{StaticResource TriggerChipLineBrush}" BorderThickness="1">
            <TextBlock x:Name="ParentText" FontWeight="SemiBold" FontSize="14.5" TextWrapping="Wrap"/>
        </Border>
        <Border x:Name="UpdateNote" Margin="0,10,0,0" Padding="12,8" CornerRadius="7" Visibility="Collapsed"
                Background="{StaticResource WarnSoftBrush}" BorderBrush="{StaticResource WarnLineBrush}" BorderThickness="1">
            <TextBlock x:Name="UpdateText" TextWrapping="Wrap" Foreground="{StaticResource WarnBrush}"/>
        </Border>
        <TextBlock Text="Details" Margin="0,14,0,4" Foreground="{StaticResource LabelBrush}"/>
        <TextBox x:Name="DetailsBox" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="300" VerticalScrollBarVisibility="Auto"
                 FontFamily="{StaticResource MonoFont}" FontSize="12.5" VerticalContentAlignment="Top"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <!-- Cancel is the default, so Enter never publishes by accident. -->
            <Button Content="Cancel" IsCancel="True" IsDefault="True" Margin="0,0,8,0" MinWidth="100"/>
            <Button x:Name="ConfirmButton" Style="{StaticResource PrimaryButton}" MinWidth="160" Click="Confirm_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
