<Window x:Class="EspansoEditor.App.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="520" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" FontFamily="{StaticResource UiFont}" FontSize="13.5" Background="#FFFFFF">
    <StackPanel Margin="22,18,22,18">
        <TextBlock x:Name="PromptText" Style="{StaticResource FieldLabel}" TextWrapping="Wrap"/>
        <ComboBox x:Name="OptionsBox" IsEditable="True" MinHeight="34" Visibility="Collapsed" VerticalContentAlignment="Center"/>
        <TextBox x:Name="ValueBox" TextChanged="ValueBox_TextChanged"/>
        <TextBlock x:Name="PreviewText" Margin="0,8,0,0" Foreground="{StaticResource AccentDarkBrush}" TextWrapping="Wrap" Visibility="Collapsed"/>
        <TextBlock x:Name="HintText" Margin="0,8,0,0" Foreground="{StaticResource MutedBrush}" FontSize="12.5" TextWrapping="Wrap" Visibility="Collapsed"/>
        <TextBlock x:Name="ErrorText" Margin="0,8,0,0" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap" Visibility="Collapsed"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Cancel" IsCancel="True" Margin="0,0,8,0" MinWidth="90"/>
            <Button x:Name="OkButton" Content="OK" IsDefault="True" Style="{StaticResource PrimaryButton}" MinWidth="90" Click="Ok_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
