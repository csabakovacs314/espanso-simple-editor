<Window x:Class="EspansoEditor.App.TriggerSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Trigger settings" Width="640" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" FontFamily="{StaticResource UiFont}" FontSize="13.5"
        Background="{StaticResource PanelBrush}" Foreground="{StaticResource InkBrush}">
    <StackPanel Margin="24,20,24,20">
        <TextBlock Text="Only as a whole word" Style="{StaticResource SectionTitle}"/>
        <TextBlock Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" LineHeight="20"
                   Text="A whole-word trigger fires only after you type a space, Enter or punctuation. Then /jira no longer fires while you are still typing /jirauao. The space or punctuation you typed stays after the text."/>

        <Border Style="{StaticResource Card}" Margin="0,16,0,0">
            <StackPanel>
                <TextBlock Text="When to switch whole word on by itself" Style="{StaticResource FieldLabel}"/>
                <RadioButton x:Name="NeededRadio" GroupName="ww" Checked="Mode_Changed"
                             Content="Only where needed (recommended): when a trigger you add would block a longer one"/>
                <RadioButton x:Name="AlwaysRadio" GroupName="ww" Checked="Mode_Changed" Margin="0,4,0,0"
                             Content="Always: every new snippet starts as whole word"/>
                <RadioButton x:Name="NeverRadio" GroupName="ww" Checked="Mode_Changed" Margin="0,4,0,0"
                             Content="Never: new snippets fire the moment you finish the trigger"/>
                <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="12.5" TextWrapping="Wrap" Margin="0,4,0,0"
                           Text="You can still switch it per snippet with the box in its Trigger section. Whole word waits for a space or Enter, and that character stays after the text."/>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Margin="0,12,0,0">
            <StackPanel>
                <TextBlock Text="All snippets" Style="{StaticResource FieldLabel}"/>
                <TextBlock x:Name="CountText" TextWrapping="Wrap"/>
                <WrapPanel Margin="0,10,0,0">
                    <Button x:Name="AllOnButton" Content="Set all to whole word" Margin="0,0,8,0" Click="AllOn_Click"
                            ToolTip="Every trigger then waits for a space or Enter, which stays after the text. Usually 'only where needed' below is the better choice."/>
                    <Button x:Name="AllOffButton" Content="Set all to none" Click="AllOff_Click"
                            ToolTip="Every trigger fires the moment you finish typing it (Espanso's default)."/>
                </WrapPanel>
                <TextBlock x:Name="LockedText" Foreground="{StaticResource MutedBrush}" FontSize="12.5" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed"/>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Margin="0,12,0,0">
            <StackPanel>
                <TextBlock Text="Triggers that block a longer trigger" Style="{StaticResource FieldLabel}"/>
                <TextBlock x:Name="ClashText" TextWrapping="Wrap" FontFamily="{StaticResource MonoFont}" FontSize="13" LineHeight="21"/>
                <Button x:Name="NeededButton" Click="Needed_Click" HorizontalAlignment="Left" Margin="0,10,0,0"/>
                <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="12.5" TextWrapping="Wrap" Margin="0,8,0,0"
                           Text="Turns whole word on only for the short triggers listed above. Every other trigger still fires the moment you finish typing it."/>
            </StackPanel>
        </Border>

        <Border x:Name="ResultBar" Visibility="Collapsed" Margin="0,12,0,0" Padding="14,10" CornerRadius="8" BorderThickness="1"
                Background="{StaticResource AccentSoftBrush}" BorderBrush="{StaticResource TriggerChipLineBrush}">
            <DockPanel>
                <Button x:Name="UndoButton" DockPanel.Dock="Right" Content="Undo" Margin="12,0,0,0" Click="Undo_Click" VerticalAlignment="Center"/>
                <TextBlock x:Name="ResultText" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{StaticResource AccentDarkBrush}"/>
            </DockPanel>
        </Border>

        <DockPanel Margin="0,18,0,0">
            <Button DockPanel.Dock="Right" Content="Close" Style="{StaticResource PrimaryButton}" MinWidth="96" IsCancel="True" IsDefault="True" Click="Close_Click"/>
            <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="12.5" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"
                       Text="Nothing is written until you press Ctrl+S. Each save adds or removes one line per snippet and keeps a backup."/>
        </DockPanel>
    </StackPanel>
</Window>
