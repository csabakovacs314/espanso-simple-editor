<Window x:Class="EspansoEditor.App.SnippetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="880" Height="840" MinWidth="640" MinHeight="520" WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource UiFont}" FontSize="13.5" Background="{StaticResource PanelBrush}" Foreground="{StaticResource InkBrush}" PreviewKeyDown="Window_PreviewKeyDown">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource SideBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="14,8">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Click="Save_Click" ToolTip="Save all changes (Ctrl+S)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE74E;" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Save"/>
                    </StackPanel>
                </Button>
                <TextBlock x:Name="HeaderText" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>
        <ContentControl x:Name="Host"/>
    </DockPanel>
</Window>
